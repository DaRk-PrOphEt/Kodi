<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="script.pr0phet" name="Pr0phEt" version="1.0.0" provider-name="Pr0phEt">
    <requires>
        <import addon="xbmc.python" version="3.0.1" />
        <import addon="repository.jurialmunkey" version="3.4" />
    </requires>
    <extension point="xbmc.python.script" library="default.py">
        <provides>executable</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="fr_FR">Arctic Fuse 3 configuré par Pr0phEt</summary>
        <description lang="fr_FR">Installe l'habillage Arctic Fuse 3 et applique la configuration de Pr0phEt (menus, widgets, réglages). Demande Kodi 21 ou plus récent.</description>
        <platform>all</platform>
        <assets>
            <icon>icon.png</icon>
        </assets>
    </extension>
</addon>
