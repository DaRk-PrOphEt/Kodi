  <addon id="repository.vstream" name="vStream Repository" version="0.0.6" provider-name="Venom">
    <extension point="xbmc.addon.repository" name="vStream XBMC Addon Repository">
      <dir>
        <info compressed="false">https://raw.githubusercontent.com/Kodi-vStream/venom-xbmc-addons/master/addons.xml</info>
        <checksum>https://raw.githubusercontent.com/Kodi-vStream/venom-xbmc-addons/master/addons.xml.md5</checksum>
        <datadir zip="true">https://github.com/Kodi-vStream/venom-xbmc-addons/raw/master/repo</datadir>
      </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
      <summary lang="fr">vStream Repository</summary>
      <description lang="fr">Installer vStream</description>
      <summary lang="en">vStream Repository</summary>
      <description lang="en">Download and install vStream</description>
      <platform>all</platform>
    </extension>
  </addon>
  <addon id="script.dark-prophet" name="DaRk-PrOphEt" version="1.14.0" provider-name="DaRk-PrOphEt">
    <requires>
      <import addon="xbmc.python" version="3.0.1" />
      <import addon="script.module.qrcode" version="6.1.0" optional="true" />
    </requires>
    <extension point="xbmc.python.script" library="default.py">
      <provides>executable</provides>
    </extension>
    <extension point="xbmc.service" library="service.py" />
    <extension point="xbmc.addon.metadata">
      <summary lang="fr_FR">Arctic Fuse 3, alkoFlix et Catch-up TV configurés par DaRk-PrOphEt</summary>
      <description lang="fr_FR">Installe Arctic Fuse 3 et alkoFlix avec l'interface de DaRk-PrOphEt, en trois versions : Allégée pour les boîtiers modestes, Base, et Full avec vStream en secours. Peut ajouter Catch-up TV &amp; More dans un profil à part, avec un écran de choix au démarrage de Kodi et la saisie de tes identifiants de replay depuis un téléphone. Kodi passe en français (interface, audio, sous-titres forcés), la touche Retour arrête le film, et « Nettoyer Kodi » libère de la place. Demande Kodi 21 ou plus récent.</description>
      <platform>all</platform>
      <assets>
        <icon>icon.png</icon>
      </assets>
    </extension>
  </addon>
</addons>
